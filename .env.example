# Supabase Project URL and anon/publishable key. These are public client identifiers,
# not secrets. Never put a service-role key in NEXT_PUBLIC_* or in this repository.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OAuth provider IDs/secrets are configured in Supabase Auth, not in app env vars.
# Never put service-role/secret keys in NEXT_PUBLIC_* or commit any real credentials.

# Canonical app origin used for verification and reset redirects (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-side feature gates: set true only after the matching setup has been tested.
SUPABASE_AUTH_SCHEMA_READY=false
SUPABASE_EMAIL_DELIVERY_READY=false
BILLING_SCHEMA_READY=false

# Optional Stripe TEST MODE only. Create the USD monthly price in the Stripe test dashboard;
# configure these only in a private server environment (never NEXT_PUBLIC_*).
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_PRO_PRICE_LABEL="$12 USD / month"
